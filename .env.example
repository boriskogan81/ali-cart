# Anthropic API key used for the product-matching step
ANTHROPIC_API_KEY=

# Ship-to country (ISO 3166-1 alpha-2) and display currency
SHIP_TO=IL
CURRENCY=USD

# Seller guardrails: listings below either threshold are dropped
MIN_STORE_POSITIVE_RATE=90
MIN_STORE_ORDERS=20

# Local server port
PORT=3000

# Directory for the persistent Chromium profile (keeps your AliExpress login)
PROFILE_DIR=./profile

# Reject a listing whose landed cost is more than this many times the sheet's estimate (when the sheet has one)
MAX_PRICE_MULTIPLE=3
